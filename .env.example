# ---- open-source LLMs, served by the local Ollama container (no data leaves the machine) ----
LLM_MODEL=qwen3:8b             # answers the analyst; qwen3:14b / qwen3:32b are better with more GPU
JUDGE_MODEL=gemma3:4b          # LLM-as-a-judge: a different family than the answerer
EMBED_MODEL=nomic-embed-text   # embeddings for the semantic-similarity metric

# ---- the network the pipeline is looking at (defaults match the Docker lab) ----
NSM_INTERNAL_CIDRS=10.77.0.0/25
NSM_WORKSTATION_CIDRS=10.77.0.96/27
NSM_DCS=10.77.0.10             # domain controllers (also the DNS resolvers to ignore for DGA)
NSM_HOSTNAMES=/app/hostnames.json

# ---- thresholds scaled for the lab (a "day" is minutes, and only ~9 hosts are live) ----
NSM_LONG_CONN_SECONDS=120      # "long" external connection; real deployments use hours
NSM_SWEEP_MIN_HOSTS=8          # internal sweep threshold; a real subnet sweep hits 20+
NSM_DGA_RANDOMNESS=3.8         # per-name "surprise": ~3 for real words, 4+ for DGA names
